# Copy this file to config.cfg and fill in your local values.
#
# This project requires a locally built Boost::regex.
# See README for build instructions.

# Required: path to your locally built Boost installation
BOOST_ROOT=

# Build settings
BUILD_TYPE=RelWithDebInfo
CXX=g++
JOBS=4

# Optional Boost.Build toolset override. Leave empty to infer gcc or clang from CXX.
BOOST_TOOLSET=

#Executable profiled by perf
PERF_TARGET=regex_tests

# GoogleTest selection. 
PERF_GTEST_FILTER=*

PERF_TEST_REPEAT=100

PERF_STAT_REPEAT=5

# Sampling settings for perf record
PERF_FREQUENCY=999
PERF_CALL_GRAPH=dwarf
PERF_PERCENT_LIMIT=0.5

# Leave empty to use perf stat's default event set.
# A portable explicit set is shown below.
PERF_EVENTS=task-clock,context-switches,cpu-migrations,page-faults,cycles,instructions,branches,branch-misses